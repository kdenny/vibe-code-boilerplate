# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public Configuration (safe to commit if needed)
# -----------------------------------------------------------------------------

# Application environment
APP_ENV=development

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Tracker Configuration
# -----------------------------------------------------------------------------

# Linear workspace (public, not a secret)
# LINEAR_WORKSPACE=your-workspace

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------

# GitHub repository (public)
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo

# -----------------------------------------------------------------------------
# SECRETS (store securely, never commit)
# -----------------------------------------------------------------------------
# The following are examples of what you might need.
# Actual secrets should be stored in:
#   - Local: .env.local (gitignored)
#   - CI: GitHub Actions secrets
#   - Deploy: Platform secret management (Vercel, Fly.io, etc.)

# LINEAR_API_KEY=lin_api_xxxxx
# GITHUB_TOKEN=ghp_xxxxx (if not using gh CLI)

# -----------------------------------------------------------------------------
# Slack — VIBE cloud-agents app (VIBE-184)
# -----------------------------------------------------------------------------
# Shared Slack surface for both cloud-agent entry points (Cursor bridge +
# self-hosted Claude runner): trigger in, progress out, escalation, reply-back.
# Names only — store the VALUES in .env.local / GitHub Actions secrets / fly
# secrets. Setup runbook: recipes/integrations/slack.md
#
# SLACK_BOT_TOKEN=xoxb-xxxxx        # Bot User OAuth Token (OAuth & Permissions)
# SLACK_SIGNING_SECRET=xxxxx        # App Credentials (Basic Information) — 32 hex
# SLACK_APP_TOKEN=xapp-xxxxx        # App-Level Token (connections:write) for Socket Mode
# SLACK_CHANNEL=#_vibe-cloud-agents # Escalation + human reply-back channel
